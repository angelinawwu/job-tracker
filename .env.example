# Google Sheets integration
# ---------------------------------------------------------------
# 1. Create a Google Cloud project: https://console.cloud.google.com
# 2. Enable the "Google Sheets API" for the project.
# 3. Create a Service Account (IAM & Admin > Service Accounts) and
#    generate a JSON key for it.
# 4. Copy the values below from the JSON key file.
# 5. Share the sheet with the service account email (Editor access), and
#    uncheck "Notify people" — service accounts have no inbox.
# 6. Copy this file to .env.local and fill in the values.
#
# The tab needs a header row; the columns are matched by header name, in any
# order: Company | Position Title | Date | Link | App Materials | Status | Notes
# ("Company Name", "Found On"/"App Method", and "Contact" are also recognised.)
#
# Until these are set, the app runs in local-only mode (browser
# localStorage) and everything still works.

# The id from your sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# "client_email" from the service account JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# "private_key" from the service account JSON key (keep the \n escapes,
# wrap the whole value in double quotes)
GOOGLE_PRIVATE_KEY=""

# Optional: tab name inside the spreadsheet (defaults to "Applications").
# Must match the tab exactly, including any en dash, e.g. 2026–2027
GOOGLE_SHEETS_TAB_NAME=Applications

# Password protection
# ---------------------------------------------------------------
# When set, visitors must enter this password once; their browser is then
# remembered for a year. Leave empty locally to skip the password entirely.
APP_PASSWORD=
